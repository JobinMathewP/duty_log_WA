# Group chat ids, comma-separated. Discover them with: npm run list-groups
# Do not guess. Newer sessions may use @lid participant ids; store ids as received.
TARGET_GROUP_IDS="120363000000000000@g.us"

# Messages loaded per group on every ready event. The library has no date filter.
HISTORICAL_FETCH_LIMIT=300

# Duty-log clock mismatch that raises HOURS_MISMATCH, in decimal hours.
HOURS_MISMATCH_THRESHOLD=0.5

# Spreadsheet id from the sheet URL: /spreadsheets/d/<id>/edit
# Share that spreadsheet with the service account client_email as Editor.
GOOGLE_SPREADSHEET_ID="your-spreadsheet-id"
GOOGLE_SHEET_TAB_NAME="Raw_Logs"
GOOGLE_SERVICE_ACCOUNT_KEY_FILE="./credentials.json"

# Optional. A standard duty log never calls Gemini.
# Free-tier prompts can be used by Google to improve its products and include employee names.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"
ENABLE_AI_FALLBACK=false

LOG_LEVEL="info"
STATE_FILE_PATH="./data/sync_state.json"
